    "There is no email account associated to this device. If you have any questions, please feel free to reach out to us at %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist kein E-Mail-Konto mit diesem Gerät verknüpft. Falls Sie Fragen haben, können Sie uns gerne unter %@ kontaktieren."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay ninguna cuenta de correo electrónico asociada a este dispositivo. Si tienes alguna pregunta, no dudes en contactarnos en %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun compte e-mail n’est associé à cet appareil. Si vous avez des questions, n’hésitez pas à nous contacter à %@"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस डिवाइस से कोई ईमेल खाता संबद्ध नहीं है। यदि आपके कोई प्रश्न हैं, तो कृपया हमसे %@ पर संपर्क करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada akun email yang terkait dengan perangkat ini. Jika Anda memiliki pertanyaan, jangan ragu untuk menghubungi kami di %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è presente alcun account email associato a questo dispositivo. Se hai domande, contattaci a %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスに関連付けられたメールアカウントはありません。ご不明な点がございましたら、%@までお気軽にお問い合わせください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에 연결된 이메일 계정이 없습니다. 궁금한 점이 있으시면 언제든지 %@로 문의해 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há nenhuma conta de email associada a este dispositivo. Se tiver alguma dúvida, sinta-se à vontade para entrar em contato conosco em %@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На этом устройстве не связан аккаунт электронной почты. Если у вас есть вопросы, пожалуйста, свяжитесь с нами по адресу %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备未关联任何电子邮箱账号。如有任何疑问，请通过 %@ 与我们联系"
          }
        }
      }
    },
